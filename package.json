{
  "name": "smart-rider-app",
  "version": "1.0.0",
  "description": "Smart Rider - Bicycle Safety Alert App",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:bridge": "esbuild src/capacitor-bridge.js --bundle --outfile=public/js/capacitor-bridge.js --platform=browser --target=es2017 --format=iife",
    "build:beeps": "node scripts/generate-beeps.js",
    "cap:sync": "npm run build:bridge && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor-community/native-audio": "^8.0.0",
    "@capacitor-community/text-to-speech": "^8.0.1",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@supabase/supabase-js": "^2.107.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
